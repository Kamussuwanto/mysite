# ==========================================
# 2. USER AUTHENTICATION MODEL
# ==========================================
class User(UserMixin):
    # CRITICAL: Make sure customer_name=None and is_admin=0 have default assignments!
    def __init__(self, id, username, customer_name=None, is_admin=0):
        self.id = id
        self.username = username
        self.customer_name = customer_name
        self.is_admin = is_admin

@login_manager.user_loader
def load_user(user_id):
    # FETCH ADDED: isAdmin column from database query
    query = text("SELECT customerID, username, customerName, isAdmin FROM users WHERE customerID = :id")
    result = db.session.execute(query, {"id": int(user_id)}).mappings().first()
    if result:
        return User(
            id=result["customerID"],
            username=result["username"],
            customer_name=result["customerName"],
            is_admin=result["isAdmin"] # Pass value to User object
        )
    return None

# ==========================================
# 3. ROUTE CONTROLLERS (AUTHENTICATION)
# ==========================================
@app.route('/login', methods=['GET', 'POST'])
def login():
    if request.method == 'GET':
        return render_template('login.html')

    username_input = request.form.get('username')
    password_input = request.form.get('password')

    try:
        # Check if the username exists in the users table
        query = text("SELECT customerID, username, password_hash FROM users WHERE username = :user")
        user_record = db.session.execute(query, {"user": username_input}).mappings().first()

        # Validate username match and verify hashed password security credentials
        if user_record and check_password_hash(user_record["password_hash"], password_input):
            user_obj = User(id=user_record["customerID"], username=user_record["username"])
            login_user(user_obj) # Create the secure session cookie tracker
            flash("Logged in successfully!", "success")
            return redirect(url_for('checkout'))
        else:
            return render_template('login.html', error="Invalid username or password credentials.")

    except Exception as e:
        # CRITICAL FIX: Clear the broken state from the connection pool immediately
        db.session.rollback()
        return f"Database Authenticator Error Encountered: {str(e)}"

@app.route('/logout')
@login_required
def logout():
    logout_user()
    flash("You have been logged out.", "info")
    return redirect(url_for('login'))

# ==========================================
# 4. ROUTE CONTROLLERS (STOREFRONT & CHECKOUT)
# ==========================================

    # ==========================================
    # HANDLE STOREFRONT PAGE (GET REQUEST)
    # ==========================================

@app.route('/checkout', methods=['GET', 'POST'])
@login_required
def checkout():
    if request.method == 'GET':
        try:
            get_products_query = text("SELECT productCode, productName, price, stock FROM products")
            products_result = db.session.execute(get_products_query).mappings().all()

            # CLEANER: You only need to pass the products list now!
            return render_template('storefront.html', products=products_result)

        except Exception as error:
            db.session.rollback()
            return f"Failed to load products table dashboard. Error: {str(error)}"

    # ==========================================
    # HANDLE INVENTORY PURCHASE (POST REQUEST)
    # ==========================================
    customer_id = current_user.id
    shopping_cart = []
    total_items_count = int(request.form.get("total_items_count", 0))

    for i in range(total_items_count):
        qty = int(request.form.get(f"qty_{i}", 0))
        if qty > 0:
            shopping_cart.append({
                "code": request.form.get(f"code_{i}"),
                "name": request.form.get(f"name_{i}"),
                "qty": qty,
                "price": float(request.form.get(f"price_{i}"))
            })

    if not shopping_cart:
        flash("Your cart is completely empty. Please increase your item quantities.", "danger")
        return redirect(url_for('checkout'))

    try:
        # Step A: Insert master purchase row into orders
        insert_order_query = text("INSERT INTO orders (customerID) VALUES (:customer_id)")
        result = db.session.execute(insert_order_query, {"customer_id": customer_id})
        new_order_number = result.lastrowid

        # Step B: Insert dynamic child items list into order_details
        insert_items_query = text("""
            INSERT INTO order_details (orderNumber, productCode, productName, quantity, price)
            VALUES (:order_num, :code, :name, :qty, :price)
        """)
        items_data = [
            {
                "order_num": new_order_number,
                "code": item["code"],
                "name": item["name"],
                "qty": item["qty"],
                "price": item["price"]
            }
            for item in shopping_cart
        ]
        db.session.execute(insert_items_query, items_data)

        # Step C: Deduct item quantities safely.

        # =======================================================
        # Step C: Check and deduct item quantities safely
        # =======================================================

        # 1. Look up the exact product's current stock first
        check_stock_query = text("SELECT stock, productName FROM products WHERE productCode = :code")

        # 2. Update query layout
        deduct_stock_query = text("""
            UPDATE products
            SET stock = stock - :qty
            WHERE productCode = :code
        """)

        for item in shopping_cart:
            # Fetch the latest accurate stock number from MySQL
            product_record = db.session.execute(check_stock_query, {"code": item["code"]}).mappings().first()

            # If the item doesn't exist, or the requested quantity is too high, throw the alert!
            if not product_record or product_record["stock"] < item["qty"]:
                item_name = product_record["productName"] if product_record else item["name"]
                raise Exception(f"Inadequate stock inventory remaining for item: {item_name}")

            # If stock is perfectly fine, execute the subtraction safely
            db.session.execute(deduct_stock_query, {"qty": item["qty"], "code": item["code"]})

        # Step D: Complete the secure atomic commit handshake
        db.session.commit()

        # Step D: Complete the secure atomic commit handshake
        #db.session.commit()
        return render_template('checkout.html', order_id=new_order_number, cart=shopping_cart)


    #except Exception as error:
        #db.session.rollback()

        # CRITICAL DEBUG: This forces the screen to show you the EXACT error text!
        #return f"STOP! Checkout crashed because of this hidden error: {str(error)}"
    except Exception as error:
        # CRITICAL PROTECTION: Erase the broken order attempt from memory completely
        db.session.rollback()

        # FRIENDLY REDIRECT: Send the user back to the storefront with a red error alert
        flash(f"Transaction cancelled: {str(error)}", "danger")
        return redirect(url_for('checkout'))

# ==========================================
#5. Regsteration Route with email and customer name
# ==========================================

@app.route('/register', methods=['GET', 'POST'])
def register():
    if request.method == 'GET':
        return render_template('register.html')

    username_input = request.form.get('username')
    password_input = request.form.get('password')
    email_input = request.form.get('email')
    name_input = request.form.get('customerName')

    if not all([username_input, password_input, email_input, name_input]):
        return render_template('register.html', error="All fields are required.")

    try:
        # 1. Check if username or email already exists
        check_query = text("SELECT customerID FROM users WHERE username = :user OR email = :email")
        existing_user = db.session.execute(check_query, {"user": username_input, "email": email_input}).mappings().first()

        if existing_user:
            return render_template('register.html', error="Username or Email already registered.")

        # 2. AUTOMATIC ADMIND FINDER: Count how many total users exist right now
        count_query = text("SELECT COUNT(*) as total FROM users")
        user_count_result = db.session.execute(count_query).mappings().first()

        # Default assignment is 0 (regular buyer)
        is_admin_flag = 0

        # If total count is exactly 0, this is the first user! Promote them to Admin!
        if user_count_result and user_count_result["total"] == 0:
            is_admin_flag = 1

        # 3. Hash the password safely
        secure_hash = generate_password_hash(password_input)

        # 4. Insert details along with our dynamic isAdmin assignment status flag
        insert_user_query = text("""
            INSERT INTO users (username, password_hash, email, customerName, isAdmin)
            VALUES (:user, :p_hash, :email, :name, :is_admin)
        """)
        db.session.execute(insert_user_query, {
            "user": username_input,
            "p_hash": secure_hash,
            "email": email_input,
            "name": name_input,
            "is_admin": is_admin_flag  # Safely bind the variable here
        })

        db.session.commit()

        if is_admin_flag == 1:
            flash("First account created successfully! You have been granted Admin controls.", "success")
        else:
            flash("Registration successful! Please login below.", "success")

        return redirect(url_for('login'))

    except Exception as e:
        db.session.rollback()  # Protect PythonAnywhere connection pool health
        return f"Database Registration Error Encountered: {str(e)}"

