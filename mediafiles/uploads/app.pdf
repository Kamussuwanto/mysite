@app.route('/admin/restock', methods=['GET', 'POST'])
@login_required

def restock():
    # BACKEND SHIELD: Block regular users instantly
    if not current_user.is_admin:
        flash("Access Denied: Administrative privileges required.", "danger")
        return redirect(url_for('checkout'))
    # ... (Keep the rest of your restock code exactly the same)

    #def restock():
    if request.method == 'GET':
        try:
            get_products_query = text("SELECT productCode, productName, stock FROM products")
            products_result = db.session.execute(get_products_query).mappings().all()
            return render_template('restock.html', products=products_result)
        except Exception as error:
            db.session.rollback()
            return f"Failed to load inventory dashboard. Error: {str(error)}"

    # Handle the incoming vendor restock quantities (POST Request)
    product_code = request.form.get('product_code')
    topup_qty = request.form.get('quantity')
    admin_id = current_user.id  # Automatically identify the logged-in user tracking this

    if not product_code or not topup_qty:
        flash("Please select a product and enter a valid quantity.", "danger")
        return redirect(url_for('restock'))

    try:
        topup_qty = int(topup_qty)
        if topup_qty <= 0:
            flash("Restock quantity must be greater than zero.", "danger")
            return redirect(url_for('restock'))

        # OPERATION A: Add vendor quantity to the product stock level
        update_stock_query = text("""
            UPDATE products
            SET stock = stock + :qty
            WHERE productCode = :code
        """)
        result = db.session.execute(update_stock_query, {"qty": topup_qty, "code": product_code})

        if result.rowcount == 0:
            flash("Inventory error: Product code not found.", "danger")
            return redirect(url_for('restock'))

        # OPERATION B: Insert a matching history row inside vendor_logs
        insert_log_query = text("""
            INSERT INTO vendor_logs (productCode, quantityAdded, processedByCustomerID)
            VALUES (:code, :qty, :user_id)
        """)
        db.session.execute(insert_log_query, {
            "code": product_code,
            "qty": topup_qty,
            "user_id": admin_id
        })

        # Securely execute both operations atomically together!
        db.session.commit()

        flash(f"Successfully restocked {topup_qty} units and saved history log!", "success")
        return redirect(url_for('restock'))

    except Exception as error:
        # Atomic safeguard: rolls back BOTH Operation A and B if anything goes wrong
        db.session.rollback()
        flash(f"Restock transaction failed. Error: {str(error)}", "danger")
        return redirect(url_for('restock'))

#=====================================
#7 admin/report page
#=====================================
@app.route('/admin/report')
@login_required
def admin_report():
    # BACKEND SHIELD: Protect system from unauthorized consumers
    if not current_user.is_admin:
        flash("Access Denied: Administrative privileges required.", "danger")
        return redirect(url_for('checkout'))

    try:
        # QUERY 1: Fetch vendor restock history logs (Existing logic)
        get_logs_query = text("""
            SELECT
                l.logID,
                p.productName,
                l.quantityAdded,
                u.customerName,
                l.createdAt
            FROM vendor_logs l
            JOIN products p ON l.productCode = p.productCode
            JOIN users u ON l.processedByCustomerID = u.customerID
            ORDER BY l.createdAt DESC
        """)
        logs_result = db.session.execute(get_logs_query).mappings().all()

        # QUERY 2: New customer invoice tracking aggregator log list
        get_sales_query = text("""
            SELECT
                o.orderNumber,
                u.customerName,
                u.username,
                SUM(od.quantity) as total_items,
                SUM(od.quantity * od.price) as total_amount
            FROM orders o
            JOIN order_details od ON o.orderNumber = od.orderNumber
            JOIN users u ON o.customerID = u.customerID
            GROUP BY o.orderNumber, u.customerName, u.username
            ORDER BY o.orderNumber DESC
        """)
        sales_result = db.session.execute(get_sales_query).mappings().all()

        # Pass BOTH datasets safely to the admin dashboard template
        return render_template('admin_report.html', logs=logs_result, sales=sales_result)

    except Exception as error:
        db.session.rollback()  # Protect PythonAnywhere connection pool health
        return f"CRITICAL REPORT ERROR: {str(error)}"


#=====================================
#8 order/history report page
#=====================================
@app.route('/orders/history')
@login_required
def order_history():
    try:
        # We drop the createdAt column entirely and sort by orderNumber DESC
        get_orders_query = text("""
            SELECT
                o.orderNumber,
                SUM(od.quantity) as total_items,
                SUM(od.quantity * od.price) as total_amount
            FROM orders o
            JOIN order_details od ON o.orderNumber = od.orderNumber
            WHERE o.customerID = :customer_id
            GROUP BY o.orderNumber
            ORDER BY o.orderNumber DESC
        """)

        orders_result = db.session.execute(get_orders_query, {
            "customer_id": current_user.id
        }).mappings().all()

        return render_template('order_history.html', orders=orders_result)

    except Exception as error:
        db.session.rollback()  # Clears pool connection errors
        return f"Failed to load order history. Error: {str(error)}"

#=====================================
# 9 CREATE THE INVOICE DETAIL ROUTE
#=====================================
@app.route('/orders/invoice/<int:order_number>')
@login_required
def invoice_details(order_number):
    try:
        # SECURITY CHECK + FETCH: Verify this specific order belongs to the logged-in customer
        check_order_query = text("""
            SELECT orderNumber
            FROM orders
            WHERE orderNumber = :order_num AND customerID = :customer_id
        """)
        order_exists = db.session.execute(check_order_query, {
            "order_num": order_number,
            "customer_id": current_user.id
        }).mappings().first()

        # If it doesn't match or exist, throw them back to history with an alert
        if not order_exists:
            flash("Access Denied: Invoice details not found or unauthorized.", "danger")
            return redirect(url_for('order_history'))

        # Fetch the complete itemized product package list for this invoice
        get_items_query = text("""
            SELECT productName, productCode, quantity, price
            FROM order_details
            WHERE orderNumber = :order_num
        """)
        items_result = db.session.execute(get_items_query, {"order_num": order_number}).mappings().all()

        # Calculate total package cost directly in Python to display on the receipt
        total_invoice_cost = sum(item['quantity'] * item['price'] for item in items_result)

        return render_template(
            'invoice_details.html',
            order_number=order_number,
            items=items_result,
            total_cost=total_invoice_cost
        )

    except Exception as error:
        db.session.rollback()  # Flushes connection pool state on PythonAnywhere
        return f"Failed to load invoice details. Error: {str(error)}"


